# ============================================
# Git 忽略规则（项目根目录，递归生效）
# ============================================

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# ── 环境变量（含密钥，绝不能提交）──
.env
.env.local

# ── 前端依赖 ──
node_modules/

# ── 日志 ──
logs/
*.log

# ── 运行时数据（向量库 / 上传文件）──
**/chromadb/
**/uploads/

# ── IDE ──
.vscode/
.idea/
*.swp

# ── 临时文件 ──
test_import_out.txt
