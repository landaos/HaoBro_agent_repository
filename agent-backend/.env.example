# JWT配置
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# 阿里云 DashScope 配置
ALIYUN_ACCESS_KEY_SECRET=sk-your_dashscope_api_key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 接口配置（可选）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_db
DB_USER=agent_user
DB_PASSWORD=your_db_password

# LangSmith配置（可选，用于调试追踪）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=my-fastapi-langchain-project

# 模型配置
CHAT_MODEL_NAME=qwen3-max
OLLAMA_CHAT_MODEL_NAME=qwen3-max
TEXT_EMBEDDING_MODEL_NAME=text-embedding-v4
RERANKER_MODEL_NAME=qwen3-rerank

# 限流配置
RATE_LIMIT_ENABLED=false