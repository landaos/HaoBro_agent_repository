# ============================================
# .env.example - 环境变量模板
# ============================================
#
# 将此文件复制为 .env 并填入真实值
# cp .env.example .env
#
# ═══════════════════════════════════════════
# 所有配置项说明（按模块分组）：
# ═══════════════════════════════════════════
#
# --- LLM 配置 ---
# ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
# ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
# ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# --- LangSmith 配置（可选，强烈推荐） ---
# 注册：https://smith.langchain.com → Settings → Personal Access Keys
# LANGSMITH_API_KEY=ls_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_SAMPLING_RATE=1.0    # 采样率，生产环境可设 0.1（追踪 10%）
#
# --- PostgreSQL 配置 ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agent_db
# DB_USER=agent_user
# DB_PASSWORD=agent_pass
#
# --- Redis 配置 ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
#
# --- 应用配置 ---
# APP_ENV=development                     # development | production | testing
# LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
# SECRET_KEY=your-secret-key-here         # JWT 签名密钥
# API_RATE_LIMIT=60                       # 每分钟每个用户最大请求数
# CORS_ORIGINS=["http://localhost:5173"]  # 前端域名，多个用逗号分隔
#
# --- 缓存配置 ---
# CACHE_TTL=3600                          # 响应缓存过期时间（秒），0=不缓存
#
# --- 向量库配置（PGVector） ---
# EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5   # embedding 模型名称
# VECTOR_DIMENSION=768                    # embedding 向量维度（bge-base=768）
#
# --- 异步任务队列（arq） ---
# ARQ_REDIS_HOST=localhost
# ARQ_REDIS_PORT=6379
# ARQ_REDIS_DB=1
# ARQ_MAX_BURST_JOBS=10                  # 并发任务数
#
# --- 部署配置 ---
# NGINX_SERVER_NAME=your-domain.com       # 生产域名
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
#
# --- 安全配置 ---
# PROMPT_INJECTION_THRESHOLD=0.7          # prompt 注入检测阈值（0-1）
# PII_MASK_ENABLED=true                   # 是否启用 PII 脱敏（生产环境必开）
#
# --- 用户反馈 ---
# FEEDBACK_ENABLED=true                   # 是否启用用户反馈收集
#
# --- 审计日志配置 ---
# AUDIT_LOG_ENABLED=true                  # 审计日志总开关
# AUDIT_LOG_BODY=false                    # 是否记录请求体（含敏感信息的接口建议关闭）
# AUDIT_LOG_HEADERS=false                 # 是否记录请求头
# AUDIT_LOG_BATCH_SIZE=100                # 批量写入条数（生产环境建议 100-500）
# AUDIT_LOG_INTERVAL=10                   # 批量写入间隔（秒）
#
# --- 文件上传配置 ---
# MAX_UPLOAD_SIZE=52428800                # 单文件上传上限（默认 50MB）
# UPLOAD_DIR=./uploads                    # 上传文件存储目录
# SUPPORTED_FILE_TYPES=pdf,docx,txt,md,csv,html  # 允许上传的文件类型
#
# --- 对象存储配置（可选，生产环境建议用 MinIO/阿里云OSS） ---
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=agent-uploads
# S3_REGION=us-east-1
#
# --- RBAC 默认角色 ---
# DEFAULT_ROLE=viewer                     # 新用户的默认角色
# ADMIN_INIT_PASSWORD=Admin@123456        # 初始化管理员密码（首次启动后修改）
